{
  "hosting": {
    "public": "public",
    "predeploy": [
      "npm run build"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/du-lieu-ca-nhan.html",
        "destination": "/chinh-sach-bao-mat.html#quyen-cua-ban",
        "type": 301
      },
      {
        "source": "/du-lieu-ca-nhan",
        "destination": "/chinh-sach-bao-mat.html#quyen-cua-ban",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/app.html"
      },
      {
        "source": "/login.html",
        "destination": "/app.html"
      },
      {
        "source": "/app",
        "destination": "/app.html"
      },
      {
        "source": "/overview",
        "destination": "/app.html"
      },
      {
        "source": "/overview.html",
        "destination": "/app.html"
      },
      {
        "source": "/class",
        "destination": "/app.html"
      },
      {
        "source": "/class.html",
        "destination": "/app.html"
      },
      {
        "source": "/classes",
        "destination": "/app.html"
      },
      {
        "source": "/class/**",
        "destination": "/app.html"
      },
      {
        "source": "/settings",
        "destination": "/app.html"
      },
      {
        "source": "/settings.html",
        "destination": "/app.html"
      },
      {
        "source": "/settings/**",
        "destination": "/app.html"
      },
      {
        "source": "/account",
        "destination": "/app.html"
      },
      {
        "source": "/account.html",
        "destination": "/app.html"
      },
      {
        "source": "/profile",
        "destination": "/app.html"
      },
      {
        "source": "/profile.html",
        "destination": "/app.html"
      },
      {
        "source": "/tai-khoan",
        "destination": "/app.html"
      },
      {
        "source": "/tai-khoan.html",
        "destination": "/app.html"
      },
      {
        "source": "/admin",
        "destination": "/app.html"
      },
      {
        "source": "/admin.html",
        "destination": "/app.html"
      },
      {
        "source": "/admin/**",
        "destination": "/app.html"
      },
      {
        "source": "/enrollments",
        "destination": "/app.html"
      },
      {
        "source": "/enrollments.html",
        "destination": "/app.html"
      },
      {
        "source": "/enrollments/**",
        "destination": "/app.html"
      },
      {
        "source": "/onboarding",
        "destination": "/app.html"
      },
      {
        "source": "/onboarding.html",
        "destination": "/app.html"
      },
      {
        "source": "/archive",
        "destination": "/app.html"
      },
      {
        "source": "/archive.html",
        "destination": "/app.html"
      },
      {
        "source": "/practice",
        "destination": "/app.html"
      },
      {
        "source": "/practice.html",
        "destination": "/app.html"
      },
      {
        "source": "/practice/**",
        "destination": "/app.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), fullscreen=(self \"https://drive.google.com\")"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://api.ltch.example.com; media-src 'self' blob: https://api.ltch.example.com; connect-src 'self' https://api.ltch.example.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; frame-src 'self' https://your-firebase-project.firebaseapp.com https://accounts.google.com https://apis.google.com https://drive.google.com https://docs.google.com https://*.googleusercontent.com https://*.googlevideo.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/app",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "/app.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/pdfjs/pdf.worker.min.mjs",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
