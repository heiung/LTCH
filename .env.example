# Mẫu biến môi trường triển khai & vận hành CLI (KHÔNG điền khóa thật vào git)

# Cloudflare Pages (API Worker)
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_PAGES_PROJECT=your-ltch-api
ALLOWED_ORIGIN=https://ltch.example.com
API_ORIGIN=https://api.ltch.example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET=sb_secret_replace_with_real_secret
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_API_KEY=replace_with_firebase_web_api_key
MAIL_ENDPOINT=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
MAIL_SECRET=replace_with_random_hex_secret_at_least_32_chars
ADMIN_EMAIL=admin@example.com
DRIVE_OWNER_EMAIL=admin@example.com

# Google Drive OAuth (khởi tạo qua `node scripts/connect-google-drive.mjs --client-file <oauth.json>`)
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Tùy chỉnh email templates (khi đồng bộ Apps Script hoặc chạy máy chủ Node)
LTCH_SITE_URL=https://ltch.example.com
LTCH_SUPPORT_EMAIL=admin@example.com

# Cờ tính năng tùy chọn
LTCH_LESSONS_ENABLED=1
LTCH_LESSONS_AUDIENCE=all
LTCH_LESSONS_PILOT_UIDS=
LTCH_DRIVE_LINK_PREVIEW=0

# Firebase Functions legacy secrets (nếu sử dụng index.cjs)
LTCH_OTP_SECRET=
LTCH_MAIL_SECRET=
LTCH_MAIL_ENDPOINT=
